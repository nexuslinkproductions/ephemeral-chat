# R2-13 cover mode, INFRA, optional. Blueprint 4.2 and 6.1; 05-transport-hardening.md 2.1.
# This file is a template. The default artifact must contain no relay host, and the wrapper
# tree must not either: scripts/selfcheck.sh fails if "turns:" or "5349" appears there.
# Copy to relay.env and fill in from the relay operator's sheet. Never commit relay.env.
#
# Policy is forced relay: host and server reflexive candidates are dropped, so the peer
# addresses do not appear on the wire. The code then carries relay candidates only.
EPHEMERAL_RELAY_POLICY=relay-only

# The gate supplies a loopback address, so the cover case needs no external relay:
#   python3 03-build/output/probes/gate.py cover --relay-host turns:127.0.0.1:5349
EPHEMERAL_RELAY_URL=turns:127.0.0.1:5349?transport=tcp

# Short lived credentials. The harness may pass an empty pair when the relay allows anonymous
# loopback binds; a production relay must not.
EPHEMERAL_RELAY_USERNAME=REPLACE_ME
EPHEMERAL_RELAY_CREDENTIAL=REPLACE_ME
EPHEMERAL_RELAY_CREDENTIAL_TTL=600

# The optional cover path is a separate build input, never a default. A build that sets this
# without the operator's relay sheet is a failed build, not a fallback.
